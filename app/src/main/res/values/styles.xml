<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Common colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorControlHighlight">@color/accent</item>

        <item name="android:windowBackground">@color/background_app</item>

        <!-- Scrollbar color -->
        <item name="android:scrollbarThumbVertical">@color/pale_gray</item>

        <!-- ImageButton -->
        <item name="imageButtonStyle">@style/AppTheme.ImageButtonStyle</item>

        <!-- Overflow Button style -->
        <item name="android:actionOverflowButtonStyle">@style/AppTheme.OverflowButtonStyle</item>

        <!-- TabLayout style -->
        <item name="tabStyle">@style/AppTheme.TabLayout</item>

        <!-- CardView style -->
        <item name="materialCardViewStyle">@style/AppTheme.CardView</item>

        <!-- Spinner style -->
        <item name="android:spinnerStyle">@style/AppTheme.Spinner</item>
        <item name="android:spinnerItemStyle">@style/AppTheme.Spinner.Item</item>
        <item name="spinnerDropDownItemStyle">@style/AppTheme.Spinner.DropDown</item>

        <!-- TextViews styles -->
        <item name="editTextStyle">@style/AppTheme.EditText</item>
        <item name="android:textViewStyle">@style/AppTheme.TextView</item>

        <!-- CheckBox style -->
        <item name="checkboxStyle">@style/AppTheme.CheckBox</item>

        <!-- Switch style -->
        <item name="switchStyle">@style/AppTheme.Switch</item>

        <!-- ProgressBar style -->
        <item name="android:progressBarStyleHorizontal">@style/AppTheme.ProgressBar.Horizontal</item>
    </style>


    <!-- ImageButton -->
    <style name="AppTheme.ImageButtonStyle" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:tint">@color/image_button</item>
    </style>


    <!-- Overflow button style -->
    <style name="AppTheme.OverflowButtonStyle" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:tint">#FFFFFF</item>
    </style>


    <!-- TabLayout style -->
    <style name="AppTheme.TabLayout" parent="Widget.Design.TabLayout">
        <item name="android:background">@color/primary</item>
        <item name="tabIconTint">@color/tablayout_selector</item>
        <item name="tabRippleColor">@color/blue_reversed</item>
        <item name="tabIndicatorColor">#FFFFFF</item>
        <item name="tabIndicatorHeight">1dp</item>
        <item name="android:elevation">2dp</item>
    </style>


    <!-- CardView style -->
    <style name="AppTheme.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="contentPadding">8dp</item>
        <item name="cardCornerRadius">4dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/background_card</item>
    </style>


    <!-- Normal layout, CardView appearance -->
    <style name="AppTheme.Layout_CardView">
        <item name="android:background">@drawable/background_card</item>
        <item name="android:elevation">2dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>


    <!-- Normal layout, CardView appearance, no vertical margin -->
    <style name="AppTheme.Layout_CardView_NoMargin">
        <item name="android:background">@drawable/background_card</item>
        <item name="android:elevation">2dp</item>
        <item name="android:padding">8dp</item>
    </style>


    <!-- Spinner style -->
    <style name="AppTheme.Spinner" parent="Widget.AppCompat.Spinner.DropDown">
        <item name="android:popupBackground">@drawable/background_popup</item>
        <item name="android:backgroundTint">@color/gray</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="AppTheme.Spinner.Item" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>

    <style name="AppTheme.Spinner.DropDown" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>


    <!-- TextViews styles -->
    <style name="AppTheme.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/edit_underline</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:textColorHint">@color/pale_gray</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="AppTheme.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Small</item>
    </style>


    <!-- CheckBox style -->
    <style name="AppTheme.CheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="buttonTint">@color/checkbox</item>
        <item name="android:minHeight">48dp</item>
    </style>


    <!-- Switch style -->
    <style name="AppTheme.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_selector</item>
        <item name="trackTint">@color/switch_track</item>
    </style>
    
    
    <!-- ProgressBar style -->
    <style name="AppTheme.ProgressBar.Horizontal" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressTintMode">src_over</item>
        <item name="android:secondaryProgressTintMode">src_over</item>
        <item name="android:progressTint">@color/blue</item>
        <item name="android:secondaryProgressTint">@color/progressbar_secondary_default</item>
        <item name="android:indeterminateTint">@color/blue</item>
        <item name="android:progressBackgroundTint">@color/background_progressbar</item>
    </style>


    <!-- Error dialog style -->
    <style name="AppTheme.ErrorDialogStyle" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowTitleStyle">@style/AppTheme.ErrorDialogStyle.Title</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppTheme.NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppTheme.PositiveButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppTheme.NeutralButtonStyle</item>
        <item name="android:colorBackground">@color/background_popup</item>
        <item name="dialogCornerRadius">4dp</item>
    </style>

    <style name="AppTheme.ErrorDialogStyle.Title" parent="TextAppearance.AppCompat.Large">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableStart">@drawable/ic_error</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/red</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>


    <!-- Alert dialog style -->
    <style name="AppTheme.AlertDialogStyle" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowTitleStyle">@style/AppTheme.AlertDialogStyle.Title</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppTheme.NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppTheme.PositiveButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppTheme.NeutralButtonStyle</item>
        <item name="android:colorBackground">@color/background_popup</item>
        <item name="dialogCornerRadius">4dp</item>
    </style>

    <style name="AppTheme.AlertDialogStyle.Title" parent="TextAppearance.AppCompat.Large">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/orange</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableStart">@drawable/ic_warning</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/orange</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>


    <!-- Info dialog style -->
    <style name="AppTheme.InfoDialogStyle" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowTitleStyle">@style/AppTheme.InfoDialogStyle.Title</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppTheme.NegativeButtonStyle</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppTheme.PositiveButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppTheme.NeutralButtonStyle</item>
        <item name="android:colorBackground">@color/background_popup</item>
        <item name="dialogCornerRadius">4dp</item>
    </style>

    <style name="AppTheme.InfoDialogStyle.Title" parent="TextAppearance.AppCompat.Large">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableStart">@drawable/ic_info</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/gray</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>


    <!-- TimePicker style -->
    <style name="AppTheme.TimePicker" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/background_popup</item> <!-- Background -->
        <item name="colorAccent">@color/primary</item> <!-- Left background in light theme -->
        <item name="colorOnPrimary">@color/blue</item> <!-- Buttons -->
        <item name="colorControlNormal">@color/gray</item> <!-- Icon -->
        <item name="android:colorControlActivated">@color/blue</item> <!-- Selector -->
        <item name="android:textColorTertiary">@color/gray</item> <!-- Hour/Minute label -->
        <item name="android:textColorHint">@color/text_black</item> <!-- Hour/Minute text -->
        <item name="android:textColor">@color/gray</item> <!-- Type in time -->
    </style>


    <!-- Dialog buttons -->
    <style name="AppTheme.NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/blue</item>
    </style>

    <style name="AppTheme.PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/blue</item>
    </style>

    <style name="AppTheme.NeutralButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/blue</item>
    </style>

</resources>