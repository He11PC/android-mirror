    <!--Activity - Permissions -->
    <string name="permission_title">Αδεια</string>
    <string name="permission_locked_title">Η εξουσιοδότηση μπλοκαρίστηκε</string>

    <string name="permission_files_title">Επιτρέψτε την πρόσβαση σε αρχεία (απαιτείται)</string>
    <string name="permission_files_text">Η δημιουργία αντιγράφων ασφαλείας είναι αδύνατη χωρίς πρόσβαση στα αρχεία και τους φακέλους σας</string>
    <string name="permission_files_locked_text">Το Android έχει μπλοκάρει αυτή την άδεια καθιστώντας την εφαρμογή μη λειτουργική.\n\nΒεβαιωθείτε ότι το Mirror δεν θα συλλέξει ποτέ πληροφορίες για εσάς ή τα δεδομένα σας.\n\nΘέλετε να ανοίξετε τις ρυθμίσεις της εφαρμογής και να την επιτρέψετε χειροκίνητα;</string>

    <string name="permission_notifications_title">Να επιτρέπονται οι ειδοποιήσεις (συνιστάται ανεπιφύλακτα)</string>
    <string name="permission_notifications_text">Οι ειδοποιήσεις χρησιμοποιούνται για την εμφάνιση της προόδου των συνεχιζόμενων αντιγράφων ασφαλείας και του αποτελέσματος των προγραμματισμένων αντιγράφων ασφαλείας</string>
    <string name="permission_notifications_locked_text">Το Android έχει αποκλείσει αυτήν την άδεια.\n\nΘέλετε να ανοίξετε τις ρυθμίσεις της εφαρμογής και να το επιτρέψετε μη αυτόματα;</string>

    <string name="permission_battery_title">Απενεργοποίηση βελτιστοποίησης μπαταρίας (συνιστάται)</string>
    <string name="permission_battery_text">Η βελτιστοποίηση μπαταρίας Android μπορεί να είναι πολύ επιθετική και να παρεμβαίνει στα προγραμματισμένα αντίγραφα ασφαλείας</string>

    <string name="permission_permanent_title">Απενεργοποίηση ανάκλησης δικαιωμάτων (συνιστάται)</string>
    <string name="permission_permanent_text">Τα δικαιώματα μπορούν να αφαιρεθούν αυτόματα από το Android, γεγονός που μπορεί να οδηγήσει σε δυσλειτουργίες</string>

    <string name="permission_auto_startup_title">Ενεργοποίηση αυτόματης εκκίνησης (συνιστάται)</string>
    <string name="permission_auto_startup_text">Χωρίς αυτή την άδεια, τα προγραμματισμένα αντίγραφα ασφαλείας ενδέχεται να σταματήσουν να λειτουργούν μετά από επανεκκίνηση της συσκευής</string>
    <string name="permission_auto_startup_try">Κάθε κατασκευαστής διαχειρίζεται αυτή τη λειτουργία με τον δικό του τρόπο και το Mirror μπορεί μόνο να προσπαθήσει να ανοίξει την αντίστοιχη σελίδα ρυθμίσεων.\n\nΑν αυτό δεν λειτουργήσει, θα πρέπει να το ρυθμίσετε χειροκίνητα για τη συσκευή σας</string>
    <string name="permission_auto_startup_manual">Κάθε κατασκευαστής χειρίζεται αυτή τη λειτουργία με τον δικό του τρόπο, ο οποίος απαιτεί χειροκίνητη διαμόρφωση για τη συσκευή σας</string>
    <string name="permission_auto_startup_open">Ανοίξτε το</string>

