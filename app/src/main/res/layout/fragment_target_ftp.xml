<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/target_ftp_lyt"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".ui.fragments.Fragment_TargetFTP">

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/target_ftp_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="target_ftp_txt_server,target_ftp_txt_port,target_ftp_txt_path,target_ftp_txt_login,target_ftp_txt_password" />

    <TextView
        android:id="@+id/target_ftp_txt_server"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/target_common_server"
        app:layout_constraintBaseline_toBaselineOf="@+id/target_ftp_edit_server"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/target_ftp_edit_server"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:hint="@string/target_common_server_hint"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:nextFocusForward="@id/target_ftp_edit_port"
        app:layout_constraintEnd_toStartOf="@+id/target_ftp_btn_credentials_fill"
        app:layout_constraintStart_toEndOf="@+id/target_ftp_barrier"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TextContrastCheck" />

    <ImageButton
        android:id="@+id/target_ftp_btn_credentials_fill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/target_common_autofill"
        android:minWidth="32dp"
        android:minHeight="48dp"
        android:src="@drawable/ic_autofill"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/target_ftp_edit_server"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/target_ftp_edit_server" />

    <TextView
        android:id="@+id/target_ftp_txt_port"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/target_common_port"
        app:layout_constraintBaseline_toBaselineOf="@+id/target_ftp_edit_port"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/target_ftp_flow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:constraint_referenced_ids="target_ftp_edit_port,target_ftp_chk_ssl"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="8dp"
        app:flow_horizontalStyle="packed"
        app:flow_wrapMode="chain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/target_ftp_barrier"
        app:layout_constraintTop_toBottomOf="@+id/target_ftp_edit_server" />

    <EditText
        android:id="@+id/target_ftp_edit_port"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/target_ftp_port_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:minEms="3"
        android:nextFocusForward="@id/target_ftp_chk_ssl"
        tools:ignore="TextContrastCheck" />

    <CheckBox
        android:id="@+id/target_ftp_chk_ssl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:nextFocusForward="@id/target_ftp_edit_login"
        android:text="@string/target_ftp_ssl" />

    <TextView
        android:id="@+id/target_ftp_txt_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/target_common_login"
        app:layout_constraintBaseline_toBaselineOf="@+id/target_ftp_edit_login"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/target_ftp_edit_login"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:hint="@string/target_common_login_hint"
        android:importantForAutofill="no"
        android:inputType="textPersonName"
        android:nextFocusForward="@id/target_ftp_edit_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/target_ftp_barrier"
        app:layout_constraintTop_toBottomOf="@+id/target_ftp_flow"
        tools:ignore="TextContrastCheck" />

    <TextView
        android:id="@+id/target_ftp_txt_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/target_common_password"
        app:layout_constraintBaseline_toBaselineOf="@+id/target_ftp_edit_password"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/target_ftp_edit_password"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:hint="@string/target_common_password_hint"
        android:importantForAutofill="no"
        android:inputType="textWebPassword|textNoSuggestions"
        android:nextFocusForward="@id/target_ftp_edit_path"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/target_ftp_barrier"
        app:layout_constraintTop_toBottomOf="@+id/target_ftp_edit_login"
        tools:ignore="TextContrastCheck" />

    <TextView
        android:id="@+id/target_ftp_txt_path"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/target_common_path"
        app:layout_constraintBaseline_toBaselineOf="@+id/target_ftp_edit_path"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/target_ftp_edit_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp"
        android:hint="@string/target_common_path_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:gravity="top"
        android:nextFocusForward="@id/target_ftp_btn_path_search"
        app:layout_constraintEnd_toStartOf="@+id/target_ftp_btn_path_search"
        app:layout_constraintStart_toEndOf="@+id/target_ftp_barrier"
        app:layout_constraintTop_toBottomOf="@+id/target_ftp_edit_password"
        tools:ignore="TextContrastCheck" />

    <ImageButton
        android:id="@+id/target_ftp_btn_path_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/target_common_search"
        android:minWidth="32dp"
        android:minHeight="48dp"
        android:src="@drawable/ic_search"
        app:layout_constraintBottom_toBottomOf="@+id/target_ftp_edit_path"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/target_ftp_edit_password" />

    <TextView
        android:id="@+id/target_ftp_txt_warning_ssl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="16dp"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:paddingBottom="10dp"
        android:text="@string/target_ftp_ssl_warning"
        android:textColor="@color/orange"
        android:textSize="12sp"
        android:textStyle="italic"
        app:drawableLeftCompat="@drawable/ic_warning"
        app:drawableTint="@color/orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/target_ftp_edit_path"
        tools:ignore="TextContrastCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>