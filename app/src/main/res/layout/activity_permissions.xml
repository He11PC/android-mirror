<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permissions_lyt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.activities.Activity_Permissions"
    android:fitsSystemWindows="true"
    android:background="@color/primary_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/permissions_appbar_lyt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/permissions_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@null"
                android:contentDescription="@string/global_cancel"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFF" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/permissions_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginEnd="48dp"
                android:minHeight="?attr/actionBarSize"
                android:theme="?attr/actionBarTheme"
                app:title="@string/permission_title"
                app:titleCentered="true"
                app:titleTextColor="@color/design_default_color_on_primary" />

            <ImageButton
                android:id="@+id/permissions_btn_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@null"
                android:contentDescription="@string/global_ok"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />

        </RelativeLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_app">

        <GridLayout
            android:id="@+id/permissions_content_lyt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="@integer/grid_column_count"
            android:paddingStart="8dp"
            android:paddingTop="16dp"
            tools:ignore="RtlSymmetry">

            <LinearLayout
                android:id="@+id/permissions_files_lyt"
                style="@style/AppTheme.Layout_CardView"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <TextView
                    android:id="@+id/permissions_files_txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_files_title"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/blue"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/permissions_files_div"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/permissions_files_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/permission_files_text"
                    app:switchPadding="8dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/permissions_notifications_lyt"
                style="@style/AppTheme.Layout_CardView"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <TextView
                    android:id="@+id/permissions_notifications_txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_notifications_title"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/blue"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/permissions_notifications_div"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/permissions_notifications_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/permission_notifications_text"
                    app:switchPadding="8dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/permissions_battery_lyt"
                style="@style/AppTheme.Layout_CardView"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <TextView
                    android:id="@+id/permissions_battery_txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_battery_title"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/blue"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/permissions_battery_div"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/permissions_battery_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/permission_battery_text"
                    app:switchPadding="8dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/permissions_permanent_lyt"
                style="@style/AppTheme.Layout_CardView"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <TextView
                    android:id="@+id/permissions_permanent_txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_permanent_title"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/blue"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/permissions_permanent_div"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/permissions_permanent_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="@string/permission_permanent_text"
                    app:switchPadding="8dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/permissions_startup_lyt"
                style="@style/AppTheme.Layout_CardView"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill">

                <TextView
                    android:id="@+id/permissions_startup_txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_auto_startup_title"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:textColor="@color/blue"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/permissions_startup_div"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue" />

                <TextView
                    android:id="@+id/permissions_startup_txt_reboot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/permission_auto_startup_text" />

                <TextView
                    android:id="@+id/permissions_startup_txt_tentative"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/permission_auto_startup_try" />

                <TextView
                    android:id="@+id/permissions_startup_txt_manual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/permission_auto_startup_manual"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/permissions_startup_btn_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="@string/permission_auto_startup_open"
                    android:textColor="@android:color/white" />

            </LinearLayout>

        </GridLayout>

    </ScrollView>

</LinearLayout>