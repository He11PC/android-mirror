<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.Fragment_Target">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="@integer/grid_column_count"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        tools:ignore="RtlSymmetry">

        <LinearLayout
            android:id="@+id/target_protocol_lyt"
            style="@style/AppTheme.Layout_CardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_columnWeight="1">

            <TextView
                android:id="@+id/target_protocol_txt_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/edit_source"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="@color/blue"
                android:textStyle="bold" />

            <View
                android:id="@+id/target_protocol_div"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/blue" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/target_protocol_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_location"
                    android:layout_marginEnd="8dp" />

                <Spinner
                    android:id="@+id/target_protocol_spn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:id="@+id/webdav_remote_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="10dp"
                android:text="@string/target_location_warning_remote_to_webdav"
                android:textColor="@color/orange"
                android:textSize="12sp"
                android:textStyle="italic"
                app:drawableLeftCompat="@drawable/ic_warning"
                app:drawableTint="@color/orange"
                tools:ignore="TextContrastCheck"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/target_protocol_fragment_container"
            style="@style/AppTheme.Layout_CardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_columnWeight="1" />
    </GridLayout>

</ScrollView>