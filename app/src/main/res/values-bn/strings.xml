    <string name="permission_title">অনুমতি</string>
    <string name="permission_locked_title">অনুমোদন অবরুদ্ধ</string>
    <string name="permission_locked_text">অ্যান্ড্রয়েড এই অনুমতিটি ব্লক করেছে৷\n\nআপনি কি অ্যাপ সেটিংস খুলতে চান এবং ম্যানুয়ালি অনুমতি দিতে চান?</string>

    <string name="permission_files_title">ফাইল অ্যাক্সেসের অনুমতি দিন (প্রয়োজনীয়)</string>
    <string name="permission_files_text">আপনার ফাইল এবং ফোল্ডারগুলিতে অ্যাক্সেস না থাকলে ব্যাকআপগুলি অসম্ভব৷</string>
    <string name="permission_files_locked_text">অ্যান্ড্রয়েড এই অনুমতিটিকে ব্লক করেছে যা অ্যাপটিকে অ-কার্যকরী করে তুলেছে।\n\nঅনুগ্রহ করে নিশ্চিত করুন যে Mirror কখনই আপনার বা আপনার ডেটা সম্পর্কে কোনো তথ্য সংগ্রহ করবে না।\n\nআপনি কি অ্যাপ সেটিংস খুলতে চান এবং ম্যানুয়ালি অনুমতি দিতে চান?</string>

    <string name="permission_lan_title">LAN অ্যাক্সেসের অনুমতি দিন (শর্তসাপেক্ষ)</string>
    <string name="permission_lan_text">আপনার লোকাল এরিয়া নেটওয়ার্কের (LAN) ডিভাইসগুলোর সাথে যোগাযোগের জন্য Android 17 থেকে এটি প্রয়োজন</string>

    <string name="permission_notifications_title">বিজ্ঞপ্তির অনুমতি দিন (দৃঢ়ভাবে প্রস্তাবিত)</string>
    <string name="permission_notifications_text">বিজ্ঞপ্তিগুলি চলমান ব্যাকআপগুলির অগ্রগতি এবং নির্ধারিত ব্যাকআপগুলির ফলাফল প্রদর্শন করতে ব্যবহৃত হয়</string>

    <string name="permission_battery_title">ব্যাটারি অপ্টিমাইজেশান অক্ষম করুন (প্রস্তাবিত)</string>
    <string name="permission_battery_text">অ্যান্ড্রয়েড ব্যাটারি অপ্টিমাইজেশন খুব আক্রমণাত্মক হতে পারে এবং নির্ধারিত ব্যাকআপগুলিতে হস্তক্ষেপ করতে পারে</string>

    <string name="permission_permanent_title">প্রত্যাহার করার অনুমতি অক্ষম করুন (প্রস্তাবিত)</string>
    <string name="permission_permanent_text">অনুমতিগুলি Android দ্বারা স্বয়ংক্রিয়ভাবে সরানো যেতে পারে, যা ত্রুটির কারণ হতে পারে</string>

    <string name="permission_auto_startup_title">অটোস্টার্ট সক্ষম করুন (প্রস্তাবিত)</string>
    <string name="permission_auto_startup_text">এই অনুমতি ছাড়া, ডিভাইস রিস্টার্ট করার পর নির্ধারিত ব্যাকআপ কাজ করা বন্ধ করে দিতে পারে</string>
    <string name="permission_auto_startup_try">প্রতিটি নির্মাতা তার নিজস্ব উপায়ে এই বৈশিষ্ট্যটি পরিচালনা করে এবং Mirror শুধুমাত্র সংশ্লিষ্ট সেটিংস পৃষ্ঠাটি খুলতে চেষ্টা করতে পারে।\n\nব্যর্থতার ক্ষেত্রে, আপনাকে আপনার ডিভাইসে অভিযোজিত একটি ম্যানুয়াল কনফিগারেশনে যেতে হবে</string>
    <string name="permission_auto_startup_manual">প্রতিটি নির্মাতা তাদের নিজস্ব উপায়ে এই বৈশিষ্ট্যটি পরিচালনা করে, যার জন্য আপনার ডিভাইসের জন্য উপযুক্ত ম্যানুয়াল কনফিগারেশন প্রয়োজন</string>
