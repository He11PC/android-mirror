    <string name="wifi_required_title">Wi-Fi প্রয়োজন</string>
    <string name="wifi_required_text">ওয়াইফাই বিকল্পটি নির্বাচন করা হয়েছে কিন্তু বর্তমানে কোনো সংযোগ সক্রিয় নেই।\nব্যাকআপ সঞ্চালন করতে একটি ওয়াইফাই নেটওয়ার্কের সাথে সংযোগ করুন</string>
