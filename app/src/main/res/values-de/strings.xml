    <!--Activity - Permissions -->
    <string name="permission_title">Berechtigungen</string>
    <string name="permission_locked_title">Gesperrte Berechtigung</string>
    <string name="permission_locked_text">Android hat diese Berechtigung blockiert.\n\nMöchten Sie die App-Einstellungen öffnen und manuell zulassen?</string>

    <string name="permission_files_title">Dateizugriff erlauben (erforderlich)</string>
    <string name="permission_files_text">Backups sind ohne Zugriff auf Ihre Dateien und Ordner nicht möglich</string>
    <string name="permission_files_locked_text">Android hat diese Berechtigung gesperrt, so dass die App nicht funktioniert.\n\nBitte versichern Sie sich, dass Mirror niemals Informationen über Sie oder Ihre Daten sammeln wird.\n\nMöchten Sie die Einstellungen der Anwendung öffnen und sie manuell zulassen?</string>

    <string name="permission_lan_title">LAN-Zugriff erlauben (abhängig)</string>
    <string name="permission_lan_text">Erforderlich ab Android 17 für die Kommunikation mit Geräten in Ihrem lokalen Netzwerk (LAN)</string>

    <string name="permission_notifications_title">Benachrichtigungen zulassen (dringend empfohlen)</string>
    <string name="permission_notifications_text">Benachrichtigungen werden verwendet, um den Fortschritt laufender Sicherungen und das Ergebnis geplanter Sicherungen anzuzeigen</string>

    <string name="permission_battery_title">Batterieoptimierung ausschalten (empfohlen)</string>
    <string name="permission_battery_text">Die Android-Akkuoptimierung kann zu aggressiv sein und geplante Backups beeinträchtigen</string>

    <string name="permission_permanent_title">Widerruf von Berechtigungen deaktivieren (empfohlen)</string>
    <string name="permission_permanent_text">Berechtigungen können von Android automatisch entfernt werden, was zu Fehlfunktionen führen kann</string>

    <string name="permission_auto_startup_title">Aktivieren Sie den Autostart (empfohlen)</string>
    <string name="permission_auto_startup_text">Ohne diese Berechtigung können die geplanten Backups nach einem Neustart des Geräts nicht mehr funktionieren</string>
    <string name="permission_auto_startup_try">Jeder Hersteller handhabt diese Funktion auf seine eigene Weise, und Mirror kann nur versuchen, die entsprechende Einstellungsseite zu öffnen.\n\nWenn dies nicht gelingt, müssen Sie eine manuelle Konfiguration vornehmen, die auf Ihr Gerät zugeschnitten ist</string>
    <string name="permission_auto_startup_manual">Jeder Hersteller handhabt diese Funktion auf seine eigene Weise, was eine manuelle Konfiguration erfordert, die auf Ihr Gerät abgestimmt ist</string>
    <string name="permission_auto_startup_open">Öffnen</string>

