    <string name="settings_notifications_warning">कृपया इस सेटिंग को बदलने के लिए सूचनाओं की अनुमति दें</string>

    <!--Activity - Permissions -->
    <string name="permission_title">अनुमतियां</string>
    <string name="permission_locked_title">अनुमति लॉक</string>

    <string name="permission_files_title">फ़ाइल एक्सेस की अनुमति दें (आवश्यक)</string>
    <string name="permission_files_text">आपकी फ़ाइलों और फ़ोल्डरों तक पहुँच के बिना बैकअप असंभव है</string>
    <string name="permission_files_locked_text">एंड्रॉइड ने ऐप को गैर-कार्यात्मक बनाते हुए इस अनुमति को अवरुद्ध कर दिया।\n\nकृपया सुनिश्चित करें कि Mirror कभी भी आपके या आपके डेटा के बारे में कोई जानकारी एकत्र नहीं करेगा।\n\nक्या आप ऐप सेटिंग खोलना चाहते हैं और इसे मैन्युअल रूप से अनुमति देना चाहते हैं?</string>

    <string name="permission_notifications_title">सूचनाओं की अनुमति दें (अत्यधिक अनुशंसित)</string>
    <string name="permission_notifications_text">सूचनाओं का उपयोग जारी बैकअप प्रगति और शेड्यूल किए गए बैकअप परिणामों को प्रदर्शित करने के लिए किया जाता है</string>
    <string name="permission_notifications_locked_text">Android ने इस अनुमति को लॉक कर दिया है।\n\nक्या आप एप्लिकेशन की सेटिंग खोलना चाहते हैं और इसे मैन्युअल रूप से अनुमति देना चाहते हैं?</string>

    <string name="permission_battery_title">बैटरी अनुकूलन अक्षम करें (अनुशंसित)</string>
    <string name="permission_battery_text">एंड्रॉइड बैटरी ऑप्टिमाइज़ेशन बहुत आक्रामक हो सकता है और शेड्यूल किए गए बैकअप में बाधा उत्पन्न कर सकता है</string>

    <string name="permission_permanent_title">निरस्त करने की अनुमति अक्षम करें (अनुशंसित)</string>
    <string name="permission_permanent_text">Android द्वारा अनुमतियों को स्वचालित रूप से हटाया जा सकता है, जिससे खराबी हो सकती है</string>

    <string name="permission_auto_startup_title">ऑटोस्टार्ट सक्षम करें (अनुशंसित)</string>
    <string name="permission_auto_startup_text">इस अनुमति के बिना, डिवाइस के पुनरारंभ होने के बाद शेड्यूल किया गया बैकअप काम करना बंद कर सकता है</string>
    <string name="permission_auto_startup_try">प्रत्येक निर्माता इस सुविधा को अपने तरीके से संभालता है, और Mirror केवल संबंधित सेटिंग्स पृष्ठ को खोलने का प्रयास कर सकता है।\n\nविफलता के मामले में, आपको अपने डिवाइस के अनुकूल मैन्युअल कॉन्फ़िगरेशन के लिए आगे बढ़ना होगा</string>
    <string name="permission_auto_startup_manual">प्रत्येक निर्माता इस सुविधा को अपने तरीके से संभालता है, जिसके लिए आपके डिवाइस के लिए उपयुक्त मैन्युअल कॉन्फ़िगरेशन की आवश्यकता होती है</string>
    <string name="permission_auto_startup_open">खोलना</string>

