    <!--Activity - Permissions -->
    <string name="permission_title">Izin</string>
    <string name="permission_locked_title">Izin dikunci</string>
    <string name="permission_locked_text">Android mengunci izin ini.\n\nApakah Anda ingin membuka pengaturan aplikasi dan mengizinkannya secara manual?</string>

    <string name="permission_files_title">Izinkan akses file (wajib)</string>
    <string name="permission_files_text">Pencadangan tidak mungkin dilakukan tanpa memiliki akses ke file dan folder Anda</string>
    <string name="permission_files_locked_text">Android memblokir izin ini sehingga aplikasi tidak berfungsi.\n\nHarap pastikan bahwa Mirror tidak akan pernah mengumpulkan informasi apa pun tentang Anda atau data Anda.\n\nApakah Anda ingin membuka pengaturan aplikasi dan mengizinkannya secara manual?</string>

    <string name="permission_lan_title">Izinkan akses LAN (tergantung)</string>
    <string name="permission_lan_text">Diperlukan sejak Android 17 untuk berkomunikasi dengan perangkat di Local Area Network (LAN) Anda</string>

    <string name="permission_notifications_title">Izinkan notifikasi (sangat disarankan)</string>
    <string name="permission_notifications_text">Notifikasi digunakan untuk menampilkan kemajuan pencadangan yang sedang berlangsung dan hasil pencadangan terjadwal</string>

    <string name="permission_battery_title">Nonaktifkan pengoptimalan baterai (disarankan)</string>
    <string name="permission_battery_text">Pengoptimalan baterai Android bisa terlalu agresif dan mengganggu pencadangan terjadwal</string>

    <string name="permission_permanent_title">Nonaktifkan pencabutan izin (disarankan)</string>
    <string name="permission_permanent_text">Izin dapat dihapus secara otomatis oleh Android, yang dapat menyebabkan malfungsi</string>

    <string name="permission_auto_startup_title">Aktifkan mulai otomatis (disarankan)</string>
    <string name="permission_auto_startup_text">Tanpa izin ini, pencadangan terjadwal mungkin berhenti berfungsi setelah perangkat dimulai ulang</string>
    <string name="permission_auto_startup_try">Setiap pabrikan menangani fitur ini dengan caranya sendiri, dan Mirror hanya dapat mencoba membuka halaman pengaturan yang sesuai.\n\nJika terjadi kegagalan, Anda harus melanjutkan ke konfigurasi manual yang disesuaikan dengan perangkat Anda</string>
    <string name="permission_auto_startup_manual">Setiap pabrikan menangani fitur ini dengan caranya sendiri, yang memerlukan konfigurasi manual yang sesuai dengan perangkat Anda</string>
