    <!--Activity - Permissions -->
    <string name="permission_title">Engedélyek</string>
    <string name="permission_locked_title">Zárolt engedély</string>
    <string name="permission_locked_text">Az Android zárolta ezt az engedélyt.\n\nMeg akarja nyitni az alkalmazás beállításait, és manuálisan engedélyezni szeretné?</string>

    <string name="permission_files_title">Hozzáférés engedélyezése a fájlokhoz (kötelező)</string>
    <string name="permission_files_text">A biztonsági mentés lehetetlen a fájlok és mappák elérése nélkül</string>
    <string name="permission_files_locked_text">Az Android letiltotta ezt az engedélyt, így az alkalmazás nem működik.\n\nKérjük, győződjön meg arról, hogy a Mirror soha nem gyűjt adatokat Önről vagy az Ön adatairól.\n\nSzeretné megnyitni az alkalmazás beállításait és manuálisan engedélyezni azt?</string>

    <string name="permission_lan_title">LAN-hozzáférés engedélyezése (attól függően)</string>
    <string name="permission_lan_text">Az Android 17 óta szükséges a helyi hálózaton lévő eszközökkel való kommunikációhoz</string>

    <string name="permission_notifications_title">Értesítések engedélyezése (nagyon ajánlott)</string>
    <string name="permission_notifications_text">Az értesítések a folyamatban lévő biztonsági mentések folyamatának és az ütemezett biztonsági mentések eredményének megjelenítésére szolgálnak</string>

    <string name="permission_battery_title">Az akkumulátor optimalizálásának kikapcsolása (ajánlott)</string>
    <string name="permission_battery_text">Az Android akkumulátor-optimalizálása túl agresszív lehet, és zavarhatja az ütemezett biztonsági mentéseket</string>

    <string name="permission_permanent_title">Engedélyek visszavonásának letiltása (ajánlott)</string>
    <string name="permission_permanent_text">Az engedélyeket az Android automatikusan eltávolíthatja, ami működési zavarokhoz vezethet</string>

    <string name="permission_auto_startup_title">Automatikus indítás engedélyezése (ajánlott)</string>
    <string name="permission_auto_startup_text">Engedély nélkül az ütemezett biztonsági mentések a készülék újraindítása után leállhatnak</string>
    <string name="permission_auto_startup_try">Minden gyártó a maga módján kezeli ezt a funkciót, és az Mirror csak a megfelelő beállítási oldalt próbálja megnyitni.\n\nHa ez nem sikerül, akkor manuálisan kell beállítania a készülékét</string>
    <string name="permission_auto_startup_manual">Minden gyártó a maga módján kezeli ezt a funkciót, ami az Ön készülékéhez igazított kézi konfigurációt igényel</string>
